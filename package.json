{
    "name": "shape",
    "private": true,
    "description": "Build tooling for the workbench gallery and the docs-site previews. The package itself ships no compiled CSS.",
    "scripts": {
        "preview": "tailwindcss -i workbench/resources/css/preview.src.css -o workbench/resources/css/preview.css --minify",
        "preview:watch": "tailwindcss -i workbench/resources/css/preview.src.css -o workbench/resources/css/preview.css --watch",
        "docs": "tailwindcss -i workbench/resources/css/docs.src.css -o workbench/resources/css/docs.css --minify",
        "docs:watch": "tailwindcss -i workbench/resources/css/docs.src.css -o workbench/resources/css/docs.css --watch",
        "preview:seed": "tailwindcss -i workbench/resources/css/preview-seed.src.css -o workbench/resources/css/preview-seed.css --minify",
        "preview:seed:watch": "tailwindcss -i workbench/resources/css/preview-seed.src.css -o workbench/resources/css/preview-seed.css --watch"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.0",
        "tailwindcss": "^4.3.0"
    }
}
